# Shared AI Service — Production Environment Configuration Template
APP_NAME="Shared AI Service"
APP_ENV=production
APP_DEBUG=false
APP_VERSION=1.0.0

API_PREFIX=/api/v1
ENABLE_API_DOCS=false

OWL_BASE_URL=http://owl-app.local
HR_CORNER_BASE_URL=http://hr-corner-app.local
PUBLIC_CHAT_BASE_URL=http://public-chat-app.local

LLM_PROVIDER=llama_cpp
LLM_BASE_URL=http://llama-server:8080
LLM_MODEL=qwen2.5-0.5b-instruct-q4_k_m.gguf
LLM_TIMEOUT=120
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_PREFIX=shared_ai

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=3
RAG_SCORE_THRESHOLD=0.4

# File Processing Size Limits
MAX_PDF_SIZE_MB=25
MAX_VIDEO_SIZE_MB=250
MAX_AUDIO_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=3600
WHISPER_MODEL=tiny

# Recommendation Engine Weights
RECOMMENDATION_WEIGHT_DIVISION=30.0
RECOMMENDATION_WEIGHT_POSITION=25.0
RECOMMENDATION_WEIGHT_GAP=20.0
RECOMMENDATION_WEIGHT_ASSESSMENT=15.0
RECOMMENDATION_WEIGHT_RELEVANCE=10.0
RECOMMENDATION_DEFAULT_LIMIT=5
RECOMMENDATION_MAX_LIMIT=50

# LMS API & MCP Configuration
LMS_API_BASE_URL=http://owl-app.local
LMS_API_TOKEN=YOUR_OWL_LMS_API_TOKEN_HERE
LMS_API_TIMEOUT=10.0
MCP_ENABLED=true
CHAT_MAX_HISTORY=5
CHAT_MAX_TOOL_CALLS=5
TOOL_TIMEOUT=15.0

# API Security Authentication Keys (Generate 64-char random tokens for production)
AI_API_AUTH_ENABLED=true
AI_API_KEY=YOUR_SHARED_AI_API_SECRET_KEY_HERE
OWL_AI_API_KEY=YOUR_OWL_TENANT_SECRET_API_KEY_HERE
HR_AI_API_KEY=YOUR_HR_CORNER_TENANT_SECRET_API_KEY_HERE
PUBLIC_CHAT_AI_API_KEY=YOUR_PUBLIC_CHAT_TENANT_SECRET_API_KEY_HERE

# Production Rate Limits & Logging
CHAT_RATE_LIMIT_PER_MINUTE=100
CHAT_RATE_LIMIT_BURST=20
INGESTION_RATE_LIMIT_PER_MINUTE=100
SEARCH_RATE_LIMIT_PER_MINUTE=100
HEALTH_RATE_LIMIT_PER_MINUTE=300
MAX_RETRIES=2

LOG_LEVEL=INFO
CORS_ORIGINS=["http://owl-app.local", "http://hr-corner-app.local"]
